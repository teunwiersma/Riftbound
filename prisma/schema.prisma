generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Singleton table holding RiftboundContentDTO's top-level metadata.
model RiftboundContent {
  id          Int      @id @default(autoincrement())
  game        String
  version     String
  lastUpdated DateTime
  sets        Set[]

  @@map("content_metadata")
}

model Set {
  id                 String            @id
  name               String
  cards              Card[]
  riftboundContent   RiftboundContent? @relation(fields: [riftboundContentId], references: [id])
  riftboundContentId Int?

  @@map("sets")
}

model Card {
  id               String   @id
  collectorNumber  Int
  set              Set      @relation(fields: [setId], references: [id])
  setId            String
  name             String
  description      String
  type             String
  rarity           String
  faction          String
  keywords         String[]
  flavorText       String
  tags             String[]

  // CardStatsDTO
  energy Int
  might  Int
  cost   Int
  power  Int

  // CardArtDTO
  thumbnailURL   String
  fullURL        String
  // Cached image bytes, used instead of the URLs to avoid re-fetching from the source on every load.
  fullImage    Bytes?
  artist       String

  // Relation to global collection
  collectionItem CollectionCard?
  deckCards      DeckCard[]

  @@map("cards")
}

// Represents an owned card entry in the global collection.
model CollectionCard {
  id           String @id @default(uuid())
  card         Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId       String @unique
  quantity     Int    @default(0)
  holoQuantity Int    @default(0)

  @@map("collection_cards")
}

// A named deck and its current playable card list.
model Deck {
  id           String        @id @default(uuid())
  name         String
  champion     String        @default("")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  cards        DeckCard[]
  versions     DeckVersion[]

  @@map("decks")
}

// A card quantity in one of the deck builder's zones.
model DeckCard {
  deck      Deck  @relation(fields: [deckId], references: [id], onDelete: Cascade)
  deckId    String
  card      Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId    String
  zone      String
  quantity  Int   @default(1)

  @@id([deckId, cardId, zone])
  @@index([cardId])
  @@map("deck_cards")
}

// Immutable deck snapshots used for version history.
model DeckVersion {
  id        String   @id @default(uuid())
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  deckId    String
  number    Int
  setCode   String   @default("OGN")
  snapshot  Json
  savedAt   DateTime @default(now())

  @@unique([deckId, number])
  @@index([deckId, savedAt])
  @@map("deck_versions")
}